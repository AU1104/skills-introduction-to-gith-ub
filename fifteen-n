def f(a, x, y):
    return ((x <= 9) <= (x*x <= a)) and ((y*y <= a) <= (y <= 9))

for a in range(0, 500):
    ok = True
    for x in range(0, 500):
        for y in range(0, 500):
            if f(a, x, y) == False:
                ok = False
                break
    if ok == True:
        print(a)

