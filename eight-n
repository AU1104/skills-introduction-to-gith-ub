from itertools import *

c = 0
for i in product(range(9), repeat=5):
    if i[0] != 0 and i.count(0) == 1:
        ind_z = i.index(0)
        if ind_z != 4:
            if i[ind_z - 1] % 2 != 0 and i[ind_z + 1] % 2 != 0:
                c += 1
        else:
            if i[ind_z - 1] % 2 != 0:
                c += 1
print(c)

