def f(n, base):
    s = ''
    while n > 0:
        s = str(n % base) + s
        n = n // base
    return s

for i in range(1, 100):
    N = i
    n = f(N, 3)
    if N % 2 == 0:
        n = '1' + n + '00'
    else:
        su = sum([int(x) for x in n])
        su = n + f(su, 3)
    r = int(n, 3)
    if r > 168:
        print(i)
