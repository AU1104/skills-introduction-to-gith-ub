from turtle import *
tracer(0)
screensize(10000, 10000)
k = 50
lt(90)
for i in range(5):
    fd(9*k)
    rt(120)
up()
for x in range(-50, 50):
    for y in range(-50, 50):
        goto(x*k, y*k)
        dot(3, 'red')

done()

