def f(s, n):
    if s >= 103: return n % 2 == 0
    if n == 0: return  0
    h = [f(s * 2, n - 1), f(s + 1, n - 1), f(s + 6, n - 1)]
    return any(h) if (n - 1) % 2 == 0 else all(h)
print([s for s in range(1, 103) if f(s, 2)])
print([s for s in range(1, 103) if not f(s, 1) and f(s, 3)])
print([s for s in range(1, 103) if not f(s, 2) and f(s, 4)])

